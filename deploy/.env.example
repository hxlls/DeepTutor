# ============================================
# DeepTutor 部署配置
# ============================================
# 复制为 .env 后按需修改：
#   cp .env.example .env
# ============================================

# 镜像版本（升级时改这里，或直接用 ./upgrade.sh <版本>）
# latest = 最新稳定版；也可固定版本号便于回滚，如 v1.6.13
DEEPTUTOR_TAG=latest

# 前端访问端口（浏览器打开 http://服务器IP:此端口）
DEEPTUTOR_PORT=80

# 后端 API 端口（一般不用改）
DEEPTUTOR_API_PORT=8001

# 时区（必须设对，官方镜像默认 UTC）
# 影响：界面/日志时间、AI 回答「今天几号」、定时任务触发时间
DEEPTUTOR_TZ=Asia/Shanghai
